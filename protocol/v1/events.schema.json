{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s00.local/events.schema.json",
  "$defs": {
    "session.status": {
      "allOf": [
        { "$ref": "https://s00.local/envelope.schema.json#/$defs/envelope" },
        {
          "type": "object",
          "required": ["eventId", "sessionId", "seq"],
          "properties": {
            "type": { "const": "session.status" },
            "eventId": { "type": "string", "minLength": 1 },
            "sessionId": { "type": "string", "minLength": 1 },
            "seq": { "type": "integer", "minimum": 1 },
            "payload": {
              "type": "object",
              "required": ["state"],
              "properties": {
                "state": {
                  "enum": ["idle", "running", "awaiting_approval", "closed"]
                }
              }
            }
          }
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "https://s00.local/envelope.schema.json#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "error" },
            "payload": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string" },
                "retryable": { "type": "boolean" },
                "details": { "type": "object" }
              }
            }
          }
        }
      ]
    }
  }
}