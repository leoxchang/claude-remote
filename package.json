{
  "name": "claude-remote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/agent",
    "apps/relay",
    "protocol/v1"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:agent": "vitest run --root apps/agent",
    "test:mobile": "cd apps/mobile && flutter test",
    "test:s01": "vitest run --root apps/agent",
    "test:s01:live": "vitest run --config vitest.s01-live.config.ts",
    "verify:s01": "tsx scripts/s01/verify-gate.ts",
    "test:s02": "vitest run --root apps/agent",
    "test:s02:live": "S02_LIVE=1 vitest run --config vitest.s02-live.config.ts",
    "verify:s02": "tsx scripts/s02/verify-gate.ts",
    "test:s02:concurrency": "vitest run --config vitest.s02-live.config.ts",
    "test:s03": "vitest run --root apps/agent",
    "test:s03:perm00": "vitest run --config vitest.s03-perm00.config.ts",
    "test:s03:live": "vitest run --config vitest.s03-live.config.ts",
    "verify:s03": "tsx scripts/s03/verify-gate.ts",
    "coverage:agent": "vitest run --root apps/agent --coverage",
    "s00:gate": "tsx scripts/s00/gate-cli.ts",
    "test:s04:store00": "vitest run --config vitest.s04-store00.config.ts",
    "test:s04": "vitest run --root apps/agent",
    "test:s04:live": "vitest run --config vitest.s04-live.config.ts",
    "verify:s04": "tsx scripts/s04/verify-gate.ts",
    "test:s05:asr00": "vitest run --config vitest.s05-asr00.config.ts",
    "test:s05": "vitest run --root apps/agent",
    "test:s05:live": "vitest run --config vitest.s05-live.config.ts",
    "verify:s05": "tsx scripts/s05/verify-gate.ts",
    "test:relay": "vitest run --root apps/relay",
    "test:relay:contract": "vitest run --config vitest.relay-contract.config.ts",
    "coverage:relay": "vitest run --root apps/relay --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
